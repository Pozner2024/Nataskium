# Тестовая БД интеграционных тестов (docker-compose.test.yml): cp .env.test.example .env.test
# Не секрет: БД слушает только 127.0.0.1:5433 и хранит данные в tmpfs. Имя базы обязано оканчиваться на _test
POSTGRES_USER=nataskium_test
POSTGRES_PASSWORD=nataskium_test
POSTGRES_DB=nataskium_test
DATABASE_URL=postgresql://nataskium_test:nataskium_test@127.0.0.1:5433/nataskium_test
