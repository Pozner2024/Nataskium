generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Аккаунт удаляется полностью (GDPR), поэтому без deletedAt.
// CHECK добавлены вручную в миграции create_teachers: email в нижнем регистре, непустой и без пробелов
// по краям, есть способ входа, password_hash и google_id не пустые
model Teacher {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  googleId        String?   @unique @map("google_id")
  // Необязательное имя для писем и кабинета; длина и пробелы по краям — CHECK в миграции add_auth_sessions
  displayName     String?   @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens        RefreshToken[]
  passwordResets       PasswordReset[]
  pendingGoogleLinks   PendingGoogleLink[]
  pendingGoogleReauths PendingGoogleReauth[]
  quizzes              Quiz[]
  quizImages           QuizImage[]

  @@map("teachers")
}

// Сырой токен — у клиента в cookie, в базе только HMAC-SHA256 (hex).
// Семья — все токены одного входа: ротация продолжает семью, вход начинает новую.
// family_expires_at — абсолютный срок сессии, при ротации не продлевается
model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  teacherId       String    @map("teacher_id") @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  familyExpiresAt DateTime  @map("family_expires_at") @db.Timestamptz
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([familyId])
  // cleanup удаляет по expires_at < now
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Учителя ещё нет: строка Teacher создаётся только при подтверждении email, с паролем этой записи.
// На один email может быть несколько записей — у каждой свой токен и свой пароль
model PendingRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  // Переносится в Teacher при подтверждении; CHECK — как у teachers.display_name
  displayName  String?  @map("display_name")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("pending_registrations")
}

// Одноразовая ссылка сброса пароля: сырой токен — только в письме, в базе — его HMAC-SHA256 (hex).
// У учителя не больше одной записи (unique по teacher_id): новый запрос заменяет прежнюю
model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Уникальный индекс служит и индексом по FK
  @@unique([teacherId])
  // cleanup удаляет по expires_at < now
  @@index([expiresAt])
  @@map("password_resets")
}

// Привязка Google к учителю с паролем ждёт ввода этого пароля: без него владелец чужого аккаунта Google
// с тем же email (например, в Google Workspace на домене учителя) вошёл бы в аккаунт учителя.
// Сырой токен — во фрагменте ссылки страницы /auth/link-google, в базе — его HMAC. Одна запись на учителя
model PendingGoogleLink {
  id             String   @id @default(uuid()) @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  googleId       String   @map("google_id")
  tokenHash      String   @unique @map("token_hash")
  // HMAC секрета из cookie __Secure-google_link: привязку подтвердит только браузер, вернувшийся из Google.
  // Иначе атакующий прислал бы учителю свою ссылку с токеном, и учитель привязал бы чужой Google своим паролем
  linkSecretHash String   @map("link_secret_hash")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Уникальный индекс служит и индексом по FK
  @@unique([teacherId])
  // cleanup удаляет по expires_at < now
  @@index([expiresAt])
  @@map("pending_google_links")
}

// Удаление аккаунта без пароля повторным входом в Google (POST /google/reauth/start → /google/callback).
// Одноразовая: callback снимает её в одной транзакции с удалением учителя. В базе только HMAC state
model PendingGoogleReauth {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  stateHash String   @unique @map("state_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Одна запись на учителя; уникальный индекс служит и индексом по FK
  @@unique([teacherId])
  // cleanup удаляет по expires_at < now
  @@index([expiresAt])
  @@map("pending_google_reauths")
}

// Викторина учителя. Вопросы — jsonb, их форму и длины проверяет Zod (packages/shared/schemas/quiz).
// CHECK добавлены вручную в миграции create_quizzes: grading_scale только ten/five/letter, title и share_token не пустые.
// Мягкое удаление через deleted_at; при удалении аккаунта строки удаляются каскадом (GDPR)
model Quiz {
  id                 String    @id @default(uuid()) @db.Uuid
  teacherId          String    @map("teacher_id") @db.Uuid
  title              String
  shareToken         String    @unique @map("share_token")
  showAnswers        Boolean   @default(true) @map("show_answers")
  gradingScale       String?   @map("grading_scale")
  questions          Json
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  // Библиотека: задание публикуется сразу при создании; скрыть его сможет только платный тариф (пока никто)
  groupSlug          String    @default("other") @map("group_slug")
  isPublic           Boolean   @default(true) @map("is_public")
  // Номер в публичном адресе /library/quiz/<номер>-<slug>; не связан с id и shareToken
  publicNumber       Int       @unique @default(autoincrement()) @map("public_number")
  // Заготовка модерации: задание скрыто из библиотеки, пока стоит дата. Ставить её пока нечему
  moderationHiddenAt DateTime? @map("moderation_hidden_at") @db.Timestamptz

  teacher Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group   LibraryGroup @relation(fields: [groupSlug], references: [slug], onDelete: Restrict)
  images  QuizImage[]

  @@index([teacherId, deletedAt])
  @@index([groupSlug, createdAt(sort: Desc)])
  @@map("quizzes")
}

// Разделы библиотеки — данные, а не enum: новая группа добавляется миграцией без правки кода.
// CHECK в миграции create_library: названия на всех языках сайта и непустые, формат slug, slug `quiz` запрещён
model LibraryGroup {
  slug      String @id
  sortOrder Int    @unique @map("sort_order")
  names     Json

  quizzes Quiz[]

  @@map("library_groups")
}

// Загруженная учителем картинка: файл — `quiz-images/<id>.webp` в хранилище, здесь только владелец и привязка.
// id задаёт сервер (randomUUID) до записи файла: строка появляется только после успешной записи.
// quiz_id null — картинка ещё не сохранена в викторине (или отвязана): «осиротевшие» старше суток удаляет очистка
model QuizImage {
  id        String   @id @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  quizId    String?  @map("quiz_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  quiz    Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([quizId])
  // Очистка ищет quiz_id IS NULL AND created_at < порог
  @@index([quizId, createdAt])
  @@map("quiz_images")
}
