generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Аккаунт удаляется полностью (GDPR), поэтому без deletedAt.
// CHECK добавлены вручную в миграции create_teachers: email в нижнем регистре, непустой и без пробелов
// по краям, есть способ входа, password_hash и google_id не пустые
model Teacher {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  googleId        String?   @unique @map("google_id")
  // Необязательное имя для писем и кабинета; длина и пробелы по краям — CHECK в миграции add_auth_sessions
  displayName     String?   @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  pendingGoogleLinks PendingGoogleLink[]

  @@map("teachers")
}

// Сырой токен — у клиента в cookie, в базе только HMAC-SHA256 (hex).
// Семья — все токены одного входа: ротация продолжает семью, вход начинает новую.
// family_expires_at — абсолютный срок сессии, при ротации не продлевается
model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  teacherId       String    @map("teacher_id") @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  familyExpiresAt DateTime  @map("family_expires_at") @db.Timestamptz
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([familyId])
  // cleanup удаляет по expires_at < now
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Учителя ещё нет: строка Teacher создаётся только при подтверждении email, с паролем этой записи.
// На один email может быть несколько записей — у каждой свой токен и свой пароль
model PendingRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  // Переносится в Teacher при подтверждении; CHECK — как у teachers.display_name
  displayName  String?  @map("display_name")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("pending_registrations")
}

// Одноразовая ссылка сброса пароля: сырой токен — только в письме, в базе — его HMAC-SHA256 (hex).
// У учителя не больше одной записи (unique по teacher_id): новый запрос заменяет прежнюю
model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Уникальный индекс служит и индексом по FK
  @@unique([teacherId])
  // cleanup удаляет по expires_at < now
  @@index([expiresAt])
  @@map("password_resets")
}

// Привязка Google к учителю с паролем ждёт ввода этого пароля: без него владелец чужого аккаунта Google
// с тем же email (например, в Google Workspace на домене учителя) вошёл бы в аккаунт учителя.
// Сырой токен — во фрагменте ссылки страницы /auth/link-google, в базе — его HMAC. Одна запись на учителя
model PendingGoogleLink {
  id             String   @id @default(uuid()) @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  googleId       String   @map("google_id")
  tokenHash      String   @unique @map("token_hash")
  // HMAC секрета из cookie __Secure-google_link: привязку подтвердит только браузер, вернувшийся из Google.
  // Иначе атакующий прислал бы учителю свою ссылку с токеном, и учитель привязал бы чужой Google своим паролем
  linkSecretHash String   @map("link_secret_hash")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Уникальный индекс служит и индексом по FK
  @@unique([teacherId])
  // cleanup удаляет по expires_at < now
  @@index([expiresAt])
  @@map("pending_google_links")
}
