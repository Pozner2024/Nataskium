POSTGRES_USER=nataskium
POSTGRES_DB=nataskium
# Пароль задаётся только в .env (openssl rand -hex 24), сюда не записывать
POSTGRES_PASSWORD=
# В .env после двоеточия подставить тот же пароль, что в POSTGRES_PASSWORD
DATABASE_URL=postgresql://nataskium:@127.0.0.1:5432/nataskium

# Секреты API: в .env — разные значения, каждое из openssl rand -base64 48; сюда не записывать
JWT_SECRET=
HMAC_SECRET=
# Адрес фронтенда (origin без пути и /). В production — только https://, вне production — только http://
WEB_ORIGIN=http://localhost:3000
# IP или CIDR Caddy через запятую: только от них принимается X-Real-IP. В production обязателен, локально — пусто
TRUSTED_PROXY_IPS=
# Почта (Resend). Вне production можно оставить пустыми — письма не уходят.
# Без своего домена: EMAIL_FROM=onboarding@resend.dev — Resend доставит письма только на email владельца аккаунта.
# В production оба обязательны, и EMAIL_FROM не может быть на resend.dev. Ключ — только в .env, сюда не записывать
RESEND_API_KEY=
EMAIL_FROM=
