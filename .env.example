POSTGRES_USER=nataskium
POSTGRES_DB=nataskium
# Пароль задаётся только в .env (openssl rand -hex 24), сюда не записывать
POSTGRES_PASSWORD=
# В .env после двоеточия подставить тот же пароль, что в POSTGRES_PASSWORD
DATABASE_URL=postgresql://nataskium:@127.0.0.1:5432/nataskium

# Адрес и порт API (по умолчанию 127.0.0.1 и 3001; в Docker с отдельным Caddy задать API_HOST=0.0.0.0)
API_HOST=127.0.0.1
API_PORT=3001

# Секреты API: в .env — разные значения, каждое из openssl rand -base64 48; сюда не записывать
JWT_SECRET=
HMAC_SECRET=
# Адрес фронтенда (origin без пути и /). В production — только https://, вне production — только http://
WEB_ORIGIN=http://localhost:3000
# IP или CIDR Caddy через запятую: только от них принимается X-Real-IP. В production обязателен, локально — пусто
TRUSTED_PROXY_IPS=
# Почта (Resend). Вне production можно оставить пустыми — письма не уходят.
# Без своего домена: EMAIL_FROM=onboarding@resend.dev — Resend доставит письма только на email владельца аккаунта.
# В production оба обязательны, и EMAIL_FROM не может быть на resend.dev. Ключ — только в .env, сюда не записывать
RESEND_API_KEY=
EMAIL_FROM=
# Вход через Google (OAuth 2.0 / OIDC). Вне production можно оставить пустыми — вход через Google не подключается.
# В production все три обязательны; GOOGLE_REDIRECT_URI должен равняться WEB_ORIGIN + /api/auth/google/callback.
# Секрет — только в .env, сюда не записывать
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Хранилище картинок (Яндекс Object Storage). Вне production можно оставить пустыми — загрузка картинок отвечает 503.
# Для разработки — отдельный бакет nataskium-dev с публичным чтением объектов и сервисный аккаунт с правами только на него.
# В production все обязательны и только https://. Ключи — только в .env, сюда не записывать
YANDEX_S3_ENDPOINT=
YANDEX_S3_BUCKET=
YANDEX_S3_ACCESS_KEY=
YANDEX_S3_SECRET_KEY=
# Адрес бакета без / в конце, например https://storage.yandexcloud.net/nataskium-dev
IMAGES_PUBLIC_BASE_URL=
# Сверка хранилища с базой: раз в сутки удаляет из бакета файлы картинок, которых нет в базе — страховка, если файлы
# удалённого аккаунта не удалось убрать сразу. В production обязательна: задать явно true или false.
# Включать (true) только там, где бакет принадлежит ТОЛЬКО этой базе: в production — true; локально — только с отдельным dev-бакетом.
# С чужим бакетом (например, прод-бакет в dev) или пустой базой сверка удалила бы чужие файлы
IMAGE_STORAGE_RECONCILE=false
