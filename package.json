{
  "name": "nataskium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web && eslint apps/api packages/shared",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "8.72.1",
    "typescript": "^6.0.3"
  }
}
